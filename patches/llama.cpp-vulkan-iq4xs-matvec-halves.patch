From 5dc6c7fcd6605a15ce079613bbd2daa42409ccac Mon Sep 17 00:00:00 2001
From: Namiak <23253744+PrivacyPolicy404@users.noreply.github.com>
Date: Mon, 16 Nov 2026 16:04:13 -0300
Subject: [PATCH] vulkan : iq4_xs mat-vec, do the sub-block in two halves with
 2+ columns

The iq4_xs shader keeps the 32 values of B of its sub-block live across the
rows of the workgroup (8 on GCN), for every column: 41 VGPRs per column. On
GCN that is 142 VGPRs with 3 columns and 183 with 4, over the 128 that let
two waves share a SIMD, so the cost jumps between 2 and 3 columns (10240x2560:
138 -> 283 us).

With 2 or more columns the sub-block is now done in two halves of 16 values:
117 VGPRs with 3 columns. One column keeps the old layout, which is slightly
faster there. Fewer rows per workgroup is not an alternative (4 rows: 424 us
with 3 columns, 2 rows: 779), and a layout with 8 live values per column is
slower than this one (230 us).

RX 580, test-backend-ops perf, 10240x2560, us/run for 1/2/3/4/5 columns:
97/138/283/353/438 -> 96/132/173/262/307
test-backend-ops iq4_xs: MUL_MAT 55/55, MUL_MAT_ID 4/4 against the CPU.

Qwen3.8-Flash-Next, MTP with 2 drafts (verify batches of 3 columns), temp 0,
alternated arms, 8 runs each: 19.62 -> 19.76 tok/s at 12K and 18.00 -> 18.43
at 30K (same accepted drafts).

Written with AI assistance (Claude).
---
 .../vulkan-shaders/mul_mat_vec_iq4_xs.comp    | 58 ++++++++++++++++++-
 1 file changed, 56 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_iq4_xs.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_iq4_xs.comp
index a2b99d9..88aeb6e 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_iq4_xs.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_iq4_xs.comp
@@ -55,6 +55,55 @@ void calc_superblock(const uint a_offset, const uint b_offset, const uint ib32,
     }
 }
 
+// 2+ columns: the sub-block is done in two halves, so that only 16 values of B per column are live across the rows
+// instead of all 32. On GCN the layout above needs more than 128 VGPRs from 3 columns (142, 183 with 4), which
+// leaves one wave per SIMD instead of two; with one column it is still the faster one.
+void calc_superblock_cols(const uint a_offset, const uint b_offset, const uint ib32, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
+    const uint y_idx = i * QUANT_K + 32 * ib32;
+    const uint ib0 = a_offset + first_row * num_blocks_per_row + i;
+
+    [[unroll]] for (uint h = 0; h < 4; h += 2) {
+        vec4 b0[NUM_COLS][2];
+        vec4 b1[NUM_COLS][2];
+        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+            [[unroll]] for (uint l = 0; l < 2; ++l) {
+                b0[j][l] = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + h + l]);
+                b1[j][l] = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 4 + h + l]);
+            }
+        }
+
+        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
+            const uint ibi = ib0 + n * num_blocks_per_row;
+            const float d = float(data_a[ibi].d);
+            const uint sl = (data_a[ibi].scales_l[ib32/2] >> (4 * (ib32 & 1))) & 0xF;
+            const uint sh = (data_a[ibi].scales_h >> (2 * ib32)) & 3;
+            const float dscale = d * float(int(sl | (sh << 4)) - 32);
+
+            FLOAT_TYPE sum[NUM_COLS];
+            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+                sum[j] = FLOAT_TYPE(0);
+            }
+
+            [[unroll]] for (uint l = 0; l < 2; ++l) {
+                const uint w = data_a_packed32[ibi].qs[4 * ib32 + h + l];
+                const u8vec4 q0 = unpack8(w & 0x0F0F0F0F);
+                const u8vec4 q1 = unpack8((w >> 4) & 0x0F0F0F0F);
+                const vec4 w0 = vec4(kvalues_iq4nl[q0.x], kvalues_iq4nl[q0.y], kvalues_iq4nl[q0.z], kvalues_iq4nl[q0.w]);
+                const vec4 w1 = vec4(kvalues_iq4nl[q1.x], kvalues_iq4nl[q1.y], kvalues_iq4nl[q1.z], kvalues_iq4nl[q1.w]);
+
+                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+                    const vec4 acc = fma(b0[j][l], w0, b1[j][l] * w1);
+                    sum[j] += FLOAT_TYPE((acc.x + acc.y) + (acc.z + acc.w));
+                }
+            }
+
+            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+                temp[j][n] = fma(dscale, sum[j], temp[j][n]);
+            }
+        }
+    }
+}
+
 void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
     uint a_offset, b_offset, d_offset;
 
@@ -74,8 +123,13 @@ void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
         }
     }
 
-    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
-        calc_superblock(a_offset, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);
+    if (NUM_COLS >= 2) {
+        [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
+            calc_superblock_cols(a_offset, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);
+    } else {
+        [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
+            calc_superblock(a_offset, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);
+    }
 
     reduce_result(temp, d_offset, first_row, num_rows, tid);
 }
-- 
