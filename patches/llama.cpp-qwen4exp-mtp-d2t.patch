From 7f6652642b1adc3977f35fc3f7654ad34f2e8945 Mon Sep 17 00:00:00 2001
From: Namiak <23253744+PrivacyPolicy404@users.noreply.github.com>
Date: Mon, 16 Nov 2026 09:19:22 -0300
Subject: [PATCH] qwen4exp : optional reduced output vocabulary (d2t) for MTP
 draft files

The MTP draft block spends most of its time in the output projection
(248320 rows here), yet almost all drafted tokens come from a small part of
the vocabulary. If the file has a `d2t` tensor (I64, K token ids),
`output.weight` is loaded with K rows and the logits are scattered to the
full vocabulary with the rest at -inf, the same convention eagle3 and dflash
already use. The target still verifies against the full vocabulary, so the
output distribution does not change; only the draft acceptance could
(frequency-ranked drafting, as in FR-Spec, arXiv 2502.14856).

RX 580, Qwen3.8-Flash-Next, MTP with 2 drafts, the 65536 most frequent
tokens (99.7 % coverage of real outputs), temp 0, alternated arms, same text
and same accepted drafts: 18.76-18.88 -> 19.18-19.25 tok/s at 12K and
17.52-17.61 -> 17.84-18.11 at 30K (+2 %), VRAM 7.34 -> 7.10 GiB. At temp 0.8
(5 seeds per arm) no seed lost accepted drafts.

Written with AI assistance (Claude).
---
 src/models/qwen4exp.cpp | 33 ++++++++++++++++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 181e4dc..a9df796 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -190,7 +190,15 @@ void llama_model_qwen4exp::load_arch_tensors(llama_model_loader & ml) {
     hc_head_down = create_tensor(tn(LLM_TENSOR_HC_HEAD_DOWN, "weight"), { hc_dim, hc_lr }, trunk_flags);
     hc_head_up   = create_tensor(tn(LLM_TENSOR_HC_HEAD_UP,   "weight"), { hc_lr, hc_dim }, trunk_flags);
 
-    output = create_tensor(tn(LLM_TENSOR_OUTPUT, "weight"), { n_embd, n_vocab }, TENSOR_NOT_REQUIRED);
+    // reduced output vocab (optional, for MTP draft files): output.weight holds only the rows of the tokens in d2t
+    int64_t n_vocab_out = n_vocab;
+    if (const struct ggml_tensor * d2t_meta = ml.get_tensor_meta("d2t")) {
+        n_vocab_out = d2t_meta->ne[0];
+        d2t = create_tensor(tn(LLM_TENSOR_D2T), { n_vocab_out }, 0);
+        LLAMA_LOG_INFO("%s: output restricted to %lld of %lld tokens (d2t)\n", __func__, (long long) n_vocab_out, (long long) n_vocab);
+    }
+
+    output = create_tensor(tn(LLM_TENSOR_OUTPUT, "weight"), { n_embd, n_vocab_out }, TENSOR_NOT_REQUIRED);
     if (output == NULL) {
         output = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), { n_embd, n_vocab }, TENSOR_DUPLICATED);
     }
@@ -329,6 +337,27 @@ std::unique_ptr<llm_graph_context> llama_model_qwen4exp::build_arch_graph(const
 }
 
 // DFlash drafters read the layer inputs as [n_embd, T] rows, so collapse the streams
+// with a reduced output vocab (d2t) the logits cover only those tokens: scatter them to the full vocabulary
+// and leave the others at -inf, like eagle3 / dflash
+static ggml_tensor * qwen4exp_d2t_scatter(ggml_context * ctx, const llama_model & model, ggml_tensor * cur) {
+    if (!model.d2t) {
+        return cur;
+    }
+
+    const int64_t n_vocab_out = cur->ne[0];
+    const int64_t n_outputs   = cur->ne[1];
+    const int64_t n_vocab     = (int64_t) model.vocab.n_tokens();
+
+    GGML_ASSERT(model.d2t->type == GGML_TYPE_I64);
+    GGML_ASSERT(model.d2t->ne[0] == n_vocab_out);
+
+    ggml_tensor * logits = ggml_fill(ctx, ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, n_vocab, n_outputs), -INFINITY);
+    cur = ggml_set_rows(ctx, logits,
+            ggml_reshape_3d(ctx, cur,       1,           n_vocab_out, n_outputs),
+            ggml_reshape_3d(ctx, model.d2t, n_vocab_out, 1,           1));
+    return ggml_reshape_2d(ctx, cur, n_vocab, n_outputs);
+}
+
 static ggml_tensor * hc_stream_mean(ggml_context * ctx, ggml_tensor * x) {
     const int64_t n_embd = x->ne[0];
     const int64_t hc     = x->ne[1];
@@ -570,6 +599,7 @@ llama_model_qwen4exp::graph::graph(const llm_graph_params & params) :
     res->t_embd = cur;
 
     cur = build_lora_mm(model.output, cur, model.output_s);
+    cur = qwen4exp_d2t_scatter(ctx0, model, cur);
     cb(cur, "result_output", -1);
     res->t_logits = cur;
 }
@@ -661,6 +691,7 @@ llama_model_qwen4exp::graph_mtp::graph_mtp(const llm_graph_params & params) :
     res->t_embd = cur;
 
     cur = build_lora_mm(model.output, cur, model.output_s);
+    cur = qwen4exp_d2t_scatter(ctx0, model, cur);
     cb(cur, "result_output", -1);
     res->t_logits = cur;
 }
