From 68b4934e71ba65369ae477153a4b7b71edcb5649 Mon Sep 17 00:00:00 2001
From: Namiak <23253744+PrivacyPolicy404@users.noreply.github.com>
Date: Mon, 16 Nov 2026 00:34:35 -0300
Subject: [PATCH] vulkan : sparse flash attention from 4x on GCN with Q8_0 K/V

The sparse path (gather the selected K/V cells, attend only to those) was
enabled for quantized K/V only when the cache is at least 16x the selection,
a break-even measured on RDNA3/RDNA4. On an RX 580 the dense path is slower
and sparse already wins at 4x: 3 queries over 16384 cells with 2051 selected
take 1155 us dense and 439 us sparse; at 8192 cells sparse is not slower.

Qwen3.8-Flash-Next, 64K context with Q8_0 K/V, temp 0, alternated arms:
without MTP 14.03 -> 14.45 tok/s at 20K and 13.72 -> 14.25 at 30K;
with MTP 17.14 -> 18.31 at 20K and 16.43 -> 17.44 at 30K.
Above 32K the route was already sparse and nothing changes.

test-backend-ops: Q8_0 cases with 1 and 3 queries, a 2051-cell selection and
8K to 64K caches (eval and perf).

Written with AI assistance (Claude).
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp |  5 ++++-
 tests/test-backend-ops.cpp           | 10 ++++++++++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index b7f3b78..d4c9bc2 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -8599,7 +8599,10 @@ void ggml_vk_flash_attn(ggml_backend_vk_context * ctx, vk_context& subctx, const
     const bool kv_f16 = k_type_eff == GGML_TYPE_F16 && v_type_eff == GGML_TYPE_F16;
     // cm2 dense is fast, so it needs a larger reduction to win.
     // With quantized K/V, sparse only breaks even around 16x (measured on RDNA3/RDNA4).
-    const int64_t min_ratio = tuning_params.path == FA_COOPMAT2 ? 4 : (kv_f16 ? 2 : 16);
+    // On GCN (measured on an RX 580, Q8_0 K/V) the dense path is slower and sparse already wins at 4x.
+    const bool kv_q8  = k_type_eff == GGML_TYPE_Q8_0 && v_type_eff == GGML_TYPE_Q8_0;
+    const bool gcn_q8 = kv_q8 && ctx->device->architecture == vk_device_architecture::AMD_GCN;
+    const int64_t min_ratio = tuning_params.path == FA_COOPMAT2 ? 4 : (kv_f16 ? 2 : (gcn_q8 ? 4 : 16));
     // coopmat2 vector decode requires 8B strides.
     auto sparse_gather_aligned = [](const ggml_tensor * t) {
         return (t->type != GGML_TYPE_F16 && t->type != GGML_TYPE_BF16) ||
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index d0a585a..7679c61 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -13117,6 +13117,11 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_flash_attn_ext(256, 256, 2, {12, 1}, 8192, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, false, 2048));
     // quantized cache, deep enough to take the sparse path
     test_cases.emplace_back(new test_flash_attn_ext(256, 256, 2, {12, 1}, 32768, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, {0, 1, 2, 3}, true, false, 2048));
+    for (int64_t kv : {8192, 16384, 32768, 65536}) {
+        for (int64_t nb : {1, 3}) {
+            test_cases.emplace_back(new test_flash_attn_ext(256, 256, 2, {12, 1}, kv, nb, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, {0, 1, 2, 3}, true, false, 2051));
+        }
+    }
     test_cases.emplace_back(new test_flash_attn_ext(256, 256, 2, {12, 1}, 32768, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q4_0, GGML_TYPE_Q4_0, {0, 1, 2, 3}, true, false, 2048));
     // single head with quantized K (MMQ on Vulkan)
     test_cases.emplace_back(new test_flash_attn_ext(128, 128, 1, { 1, 1}, 8192, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, {0, 1, 2, 3}, true, false, 512));
@@ -13826,6 +13831,11 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
     test_cases.emplace_back(new test_flash_attn_ext(64, 64, 8, {8, 1}, 7680,   1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0));
     test_cases.emplace_back(new test_flash_attn_ext(64, 64, 8, {8, 1}, 7680, 512, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0));
 
+    // Q8 sparse attention with MTP-sized query batches and a partial selection tail.
+    for (int64_t kv : {8192, 16384, 32768, 65536}) {
+        test_cases.emplace_back(new test_flash_attn_ext(256, 256, 2, {12, 1}, kv, 3, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, {0, 1, 2, 3}, true, false, 2051));
+    }
+
     // sparse decode at long context
     test_cases.emplace_back(new test_flash_attn_ext(512, 512, 1, { 8, 1}, 49152, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, false,    0));
     test_cases.emplace_back(new test_flash_attn_ext(512, 512, 1, { 8, 1}, 49152, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, false, 2048));
